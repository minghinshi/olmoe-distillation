{{- bos_token }}
{%- for message in messages %}
{%- if message['role'] == 'system' %}
{{- '<|system|>\n' }}
{{- message['content'] }}
{{- '\n' }}
{%- elif message['role'] == 'user' %}
{{- '<|user|>\n' }}
{{- message['content'] }}
{{- '\n' }}
{%- elif message['role'] == 'assistant' %}
{{- '<|assistant|>\n' }}
{%- generation %}
{{- message['content'] + eos_token }}
{%- endgeneration %}
{{- '\n' }}
{%- endif %}
{%- if loop.last and add_generation_prompt %}
{{- '<|assistant|>\n' }}
{%- endif %}
{%- endfor %}
